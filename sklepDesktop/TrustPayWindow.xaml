<Window x:Class="sklepDesktop.TrustPayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal Płatniczy - TrustPay" Height="350" Width="400" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True" Background="#F0F0F0">
    <Border BorderThickness="5" BorderBrush="#09548E" CornerRadius="10" Margin="10">
        <StackPanel VerticalAlignment="Center" Margin="20">
            <TextBlock Text="TrustPay" FontSize="44" FontWeight="ExtraBold" Foreground="#09548E" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Name="LblAmount" Text="Do zapłaty: 0,00 PLN" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Wpisz 6-cyfrowy kod autoryzacji:" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBox Name="TxtTrustPayCode" Height="50" Width="200" FontSize="32" FontWeight="Bold" TextAlignment="Center" MaxLength="6" PreviewTextInput="TxtTrustPayCode_PreviewTextInput"/>

            <Button Name="BtnPay" Content="ZATWIERDŹ" Height="50" Width="200" FontSize="20" FontWeight="Bold" Background="#1E293B" Foreground="White" Margin="0,15,0,0" Click="BtnPay_Click"/>

            <TextBlock Name="LblStatus" Text="" FontSize="16" FontWeight="Bold" Foreground="Orange" HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button Name="BtnCancel" Content="Anuluj" Height="30" Width="100" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Foreground="Gray" Click="BtnCancel_Click"/>
        </StackPanel>
    </Border>
</Window>